STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Required for login sessions. Use a long random value in production.
SECRET_KEY=replace_with_a_long_random_secret

# Railway defaults to SQLite on its mounted volume. Set explicitly for clarity.
ACCOUNT_BACKEND=sqlite

# Google Cloud OAuth 2.0 Web application credentials.
# Authorized redirect URI: https://tax-delinquencies-production.up.railway.app/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_client_secret
# GOOGLE_OAUTH_REDIRECT_URI=https://tax-delinquencies-production.up.railway.app/auth/google/callback

# County availability email alerts.
PUBLIC_BASE_URL=https://tax-delinquencies-production.up.railway.app
# Preferred on Railway because it uses HTTPS on every plan.
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM=ForeclosureLeads Pro <alerts@your-verified-domain.com>
# SMTP fallback (Railway Pro plan or above).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=alerts@example.com
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password

# Protects /admin/skiptrace. Use a long random value.
SKIPTRACE_ADMIN_TOKEN=replace_with_a_long_random_admin_token

# Explicit immutable account IDs allowed to administer the app; emails do not grant roles.
ADMIN_USER_IDS=
ADMIN_TOKEN=replace_with_a_long_random_admin_token

# Optional Appwrite account backend (requires ACCOUNT_BACKEND=appwrite).
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=replace_with_appwrite_project_id
APPWRITE_API_KEY=replace_with_appwrite_api_key
APPWRITE_DATABASE_ID=tax_delinquencies
APPWRITE_USERS_COLLECTION_ID=users
APPWRITE_ORDERS_COLLECTION_ID=orders

# Optional Postgres account backend (requires ACCOUNT_BACKEND=postgres).
# POSTGRES_URL is also supported.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Local SQLite data store used by the scraper/admin app.
# Leave unset on Railway: defaults to /data/foreclosure.sqlite3 on the mounted volume.
# SQLITE_DB=foreclosure_local.sqlite3

# Optional CA scraper tuning. Higher = more volume but slower.
CA_NOTICE_MAX_DETAILS=150
CA_NOTICE_LOOKBACK_DAYS=60

# beta: $6 raw / $15 skip-traced; post_beta: $18 / $30, before age decay.
LEAD_PRICING_PHASE=beta
